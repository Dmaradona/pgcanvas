# ---------------------------------------------------------------------------
# pgcanvas: login e biblioteca de modelos (opcional)
#
# Sem estas variaveis o app funciona inteiro, so sem conta e sem nuvem.
# Copie para .env.local e preencha com os dados do seu projeto Supabase.
#
# Estas duas sao publicas por natureza: vao no bundle do navegador de proposito.
# Quem protege os dados e o RLS declarado em supabase/schema.sql.
# ---------------------------------------------------------------------------

# Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings > API > Project API keys > anon public
# (ou a nova chave publishable, sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NUNCA coloque aqui a chave service_role nem uma sb_secret_...
# Elas ignoram o RLS e dariam acesso total ao banco para qualquer visitante.
# O app se recusa a subir se detectar uma chave secreta.
# ---------------------------------------------------------------------------
